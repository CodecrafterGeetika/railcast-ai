# When set, the app will attempt to call the live backend at this base URL
# for train status, route, ETA and metrics endpoints:
#   GET {NEXT_PUBLIC_API_BASE_URL}/api/train/{trainNumber}
#   GET {NEXT_PUBLIC_API_BASE_URL}/api/train/{trainNumber}/eta
#   GET {NEXT_PUBLIC_API_BASE_URL}/api/train/{trainNumber}/route
#   GET {NEXT_PUBLIC_API_BASE_URL}/api/metrics
#
# If unset, empty, unreachable, or returning errors/malformed data, the app
# automatically falls back to DEMO MODE with realistic mock data.
#
# Never put secret API keys here — this value is public (NEXT_PUBLIC_*) and
# shipped to the browser. Secret keys belong on the backend only.
NEXT_PUBLIC_API_BASE_URL=
